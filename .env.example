# ==============================================================================
# ELITE STEEL CONCEPTS - ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. TURSO CLOUD DATABASE (SQLite at the Edge)
# ------------------------------------------------------------------------------
# Get your Turso Database URL and Auth Token by running:
#   1. turso db create esc-db
#   2. turso db show esc-db --url
#   3. turso db tokens create esc-db
#
# When set, the website automatically synchronizes all blog posts, quotes,
# contacts, SEO data, and media images between local dev and live server!
TURSO_DATABASE_URL=libsql://esc-db-yourusername.turso.io
TURSO_AUTH_TOKEN=your_turso_jwt_auth_token_here

# ------------------------------------------------------------------------------
# 2. SITE CONFIGURATION
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://www.esteelconcepts.com

# ------------------------------------------------------------------------------
# 3. SMTP / EMAIL NOTIFICATIONS (Quotes & Contacts)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=esteelquotes@gmail.com
SMTP_PASSWORD=your_google_app_password_here
SMTP_FROM="Elite Steel Concepts <esteelquotes@gmail.com>"
NOTIFICATION_EMAIL=esteelquotes@gmail.com
SMTP_SECURE=false
